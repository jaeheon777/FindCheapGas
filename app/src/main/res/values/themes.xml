<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        앱 테마. 색은 colors.xml(values / values-night)의 이름으로만 연결하고, 밝은 테마와 어두운 테마가 같은 정의를 쓴다.
        Material3 기본 보라 계열이 남지 않도록 모든 색 역할을 앱 색으로 바꾼다.
        - colorPrimary는 텍스트 버튼, 링크 같은 글자에도 쓰여서 라임이 아니라 강조 글자색(밝게 올리브, 어둡게 라임)이다.
        - 라임 바탕은 colorPrimaryContainer, 그 위 글자는 colorOnPrimaryContainer(거의 검정)다.
        - colorSurface와 화면 바탕은 연한 회색이고, 카드·시트·하단 탭·메뉴·다이얼로그는 colorSurfaceContainer* (카드 색)다.
    -->
    <style name="Base.Theme.FindCheapGas" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_text</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/brand_lime</item>
        <item name="colorOnPrimaryContainer">@color/on_brand</item>
        <item name="colorPrimaryInverse">@color/inverse_accent</item>
        <item name="colorPrimaryFixed">@color/brand_lime</item>
        <item name="colorOnPrimaryFixed">@color/on_brand</item>
        <item name="colorPrimaryFixedDim">@color/brand_lime</item>
        <item name="colorOnPrimaryFixedVariant">@color/on_brand</item>

        <item name="colorSecondary">@color/accent_text</item>
        <item name="colorOnSecondary">@color/on_accent</item>
        <item name="colorSecondaryContainer">@color/brand_lime_soft</item>
        <item name="colorOnSecondaryContainer">@color/on_brand_soft</item>
        <item name="colorSecondaryFixed">@color/brand_lime_soft</item>
        <item name="colorOnSecondaryFixed">@color/on_brand_soft</item>
        <item name="colorSecondaryFixedDim">@color/brand_lime_soft</item>
        <item name="colorOnSecondaryFixedVariant">@color/on_brand_soft</item>

        <item name="colorTertiary">@color/accent_text</item>
        <item name="colorOnTertiary">@color/on_accent</item>
        <item name="colorTertiaryContainer">@color/brand_lime_soft</item>
        <item name="colorOnTertiaryContainer">@color/on_brand_soft</item>
        <item name="colorTertiaryFixed">@color/brand_lime_soft</item>
        <item name="colorOnTertiaryFixed">@color/on_brand_soft</item>
        <item name="colorTertiaryFixedDim">@color/brand_lime_soft</item>
        <item name="colorOnTertiaryFixedVariant">@color/on_brand_soft</item>

        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>
        <item name="colorErrorContainer">@color/error_container</item>
        <item name="colorOnErrorContainer">@color/on_error_container</item>

        <item name="android:colorBackground">@color/bg_screen</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorSurface">@color/bg_screen</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/bg_control</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceBright">@color/bg_card</item>
        <item name="colorSurfaceDim">@color/bg_screen</item>
        <item name="colorSurfaceContainerLowest">@color/bg_card</item>
        <item name="colorSurfaceContainerLow">@color/bg_card</item>
        <item name="colorSurfaceContainer">@color/bg_card</item>
        <item name="colorSurfaceContainerHigh">@color/bg_card</item>
        <item name="colorSurfaceContainerHighest">@color/bg_control</item>
        <item name="colorSurfaceInverse">@color/inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/inverse_on_surface</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_soft</item>
        <!-- 떠 있는 카드·시트에 보라빛이 섞이지 않도록 높이에 따른 색 덧칠을 끈다. -->
        <item name="elevationOverlayEnabled">false</item>

        <item name="android:textColorPrimary">@color/text_primary_state</item>
        <item name="android:textColorSecondary">@color/text_secondary_state</item>
        <item name="android:textColorTertiary">@color/text_secondary_state</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:textColorLink">@color/accent_text</item>
        <item name="android:textColorHighlight">@color/brand_lime_soft</item>
        <item name="colorControlNormal">@color/text_secondary</item>
        <item name="colorControlActivated">@color/accent_text</item>

        <!-- 글꼴: 모든 글자를 Pretendard로. Material3 글자 단계도 앱 글자 단계(styles.xml)로 바꾼다. -->
        <item name="android:fontFamily">@font/app_font</item>
        <item name="fontFamily">@font/app_font</item>
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.FindCheapGas.Number</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.FindCheapGas.Number</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.FindCheapGas.Number</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.FindCheapGas.ScreenTitle</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.FindCheapGas.ScreenTitle</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.FindCheapGas.ScreenTitle</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.FindCheapGas.ScreenTitle</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.FindCheapGas.CardTitle</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.FindCheapGas.SectionTitle</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.FindCheapGas.Body</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.FindCheapGas.BodySmall</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.FindCheapGas.Caption</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.FindCheapGas.Label</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.FindCheapGas.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.FindCheapGas.LabelSmall</item>
        <item name="android:textAppearanceLargePopupMenu">@style/TextAppearance.FindCheapGas.Body</item>
        <item name="android:textAppearanceSmallPopupMenu">@style/TextAppearance.FindCheapGas.Body</item>

        <!-- 공통 컴포넌트 스타일 (styles.xml). 레이아웃이 ?attr/로 부르는 기본 스타일도 여기서 바뀐다. -->
        <item name="materialCardViewStyle">@style/Widget.FindCheapGas.Card</item>
        <item name="materialCardViewFilledStyle">@style/Widget.FindCheapGas.Card</item>
        <item name="materialCardViewOutlinedStyle">@style/Widget.FindCheapGas.Card</item>
        <item name="materialCardViewElevatedStyle">@style/Widget.FindCheapGas.Card.Floating</item>
        <item name="materialButtonStyle">@style/Widget.FindCheapGas.Button.Primary</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.FindCheapGas.Button.Secondary</item>
        <item name="borderlessButtonStyle">@style/Widget.FindCheapGas.Button.Text</item>
        <item name="floatingActionButtonStyle">@style/Widget.FindCheapGas.FloatingActionButton</item>
        <item name="chipStyle">@style/Widget.FindCheapGas.Chip</item>
        <item name="bottomNavigationStyle">@style/Widget.FindCheapGas.BottomNavigation</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.FindCheapGas.BottomSheetDialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.FindCheapGas.MaterialAlertDialog</item>
        <item name="snackbarStyle">@style/Widget.FindCheapGas.Snackbar</item>
        <item name="textInputStyle">@style/Widget.FindCheapGas.TextInputLayout</item>
        <item name="textInputOutlinedStyle">@style/Widget.FindCheapGas.TextInputLayout</item>
        <item name="toolbarStyle">@style/Widget.FindCheapGas.Toolbar</item>

        <!--
            상태 표시줄은 화면 바탕색으로 칠하고, 아이콘 색은 밝은 테마는 어둡게, 어두운 테마는 밝게 한다
            (values-night/bools.xml). 기본값(보라 계열)은 어두운 테마에서 흰 아이콘이 잘 보이지 않는다.
        -->
        <item name="android:statusBarColor">@color/bg_screen</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
    </style>

    <style name="Theme.FindCheapGas" parent="Base.Theme.FindCheapGas" />

    <!-- 실행 직후 잠깐 보이는 로딩 화면. 첫 화면이 그려지면 Theme.FindCheapGas로 바뀐다. -->
    <style name="Theme.FindCheapGas.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.FindCheapGas</item>
    </style>
</resources>

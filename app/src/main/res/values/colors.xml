<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        앱 색 기준 (밝은 테마). 어두운 테마는 values-night/colors.xml에서 같은 이름으로 바꾼다.
        - 대표 색 라임은 바탕을 칠하는 데만 쓰고, 그 위 글자는 거의 검정(on_brand)으로 쓴다.
          흰 바탕 위 글자색으로는 쓰지 않는다 (대비 1.3:1). 작은 강조 글자는 진한 올리브(accent_text)를 쓴다.
        - 글자 대비는 WCAG AA(본문 4.5:1, 큰 글자 3:1)를 화면 바탕과 카드 바탕 모두에서 맞춘다.
    -->
    <color name="brand_lime">#FFC5F04A</color>
    <color name="on_brand">#FF111111</color>
    <!-- 선택한 목록 줄, 고른 유종 줄처럼 넓게 칠하는 연한 라임 -->
    <color name="brand_lime_soft">#FFEEF8D2</color>
    <color name="on_brand_soft">#FF111111</color>
    <!-- 작은 강조 글자, 텍스트 버튼, 스위치·진행 막대 (흰 바탕 5.47:1, 회색 바탕 4.96:1) -->
    <color name="accent_text">#FF557300</color>
    <color name="on_accent">#FFFFFFFF</color>

    <!-- 바탕 -->
    <color name="bg_screen">#FFF2F4F6</color>
    <color name="bg_card">#FFFFFFFF</color>
    <!-- 카드 안의 작은 상자 (계산 안내, 순위 원) -->
    <color name="bg_card_subtle">#FFF2F4F6</color>
    <!-- 꺼진 스위치 길, 채운 입력칸 -->
    <color name="bg_control">#FFE5E8EB</color>

    <!-- 글자 -->
    <color name="text_primary">#FF111111</color>
    <color name="text_secondary">#FF636A75</color>

    <!-- 선: outline은 입력칸 테두리(3:1 이상), outline_soft는 칩 테두리와 구분선 -->
    <color name="outline">#FF8B929C</color>
    <color name="outline_soft">#FFDDE1E6</color>

    <color name="error">#FFD42A33</color>
    <color name="on_error">#FFFFFFFF</color>
    <color name="error_container">#FFFDE7E8</color>
    <color name="on_error_container">#FF5C0B10</color>

    <!-- 스낵바처럼 반대 색으로 띄우는 것 -->
    <color name="inverse_surface">#FF1C1D21</color>
    <color name="inverse_on_surface">#FFF2F3F5</color>
    <color name="inverse_accent">#FFC5F04A</color>

    <!-- 실행 직후 로딩 화면 바탕 (화면 바탕과 같은 색) -->
    <color name="splash_background">#FFF2F4F6</color>

    <!-- 지도 위 내 위치 점 -->
    <color name="my_location_dot">#FF1A73E8</color>
    <color name="my_location_border">#FFFFFFFF</color>
    <!-- 밝은 지도 위에서 흰 테두리가 보이도록 두는 옅은 그림자 -->
    <color name="my_location_shadow">#33000000</color>
    <!--
        지도 위 주유소 가격 마커. 예상 이득 구간별 색 (초록 이득 / 회색 비슷 / 빨강 손해, 기준 ±1,000원).
        지도는 다크 모드에서도 밝은 색이라 마커 색과 범례 점 색도 하나로 둔다 (values-night에 없음).
        마커 글자 대비: 이득 흰 글자 5.31:1, 비슷 검정 글자 7.15:1, 손해 흰 글자 5.03:1.
    -->
    <color name="marker_gain_background">#FF0B7D3E</color>
    <color name="marker_gain_text">#FFFFFFFF</color>
    <color name="marker_similar_background">#FF9AA0A6</color>
    <color name="marker_similar_text">#FF111111</color>
    <color name="marker_loss_background">#FFD42A33</color>
    <color name="marker_loss_text">#FFFFFFFF</color>
    <color name="marker_selected_border">#FF1A73E8</color>

    <!-- 예상 이득 글자 (목록, 상세, 즐겨찾기, 비교 카드). 비슷은 회색이다. -->
    <color name="saving_gain_text">#FF0B7D3E</color>
    <color name="saving_similar_text">#FF636A75</color>
    <color name="saving_loss_text">#FFD42A33</color>

    <!--
        주인공 카드 (지도 탭의 이득 1위 카드, 상세 화면 맨 위 카드).
        밝게: 흰 카드 + 이득 초록 숫자, 테두리 없음 / 어둡게(values-night): 카드 색 + 라임 테두리 + 라임 숫자.
        손해·비슷 숫자는 saving_loss_text, saving_similar_text를 그대로 쓴다.
    -->
    <color name="hero_saving_gain_text">#FF0B7D3E</color>
    <color name="hero_card_stroke">#00000000</color>

    <!-- 목록 배지 -->
    <color name="badge_best_background">#FF0B7D3E</color>
    <color name="badge_best_text">#FFFFFFFF</color>
    <color name="badge_cheapest">#FF2862C8</color>
    <color name="badge_discount">#FF557300</color>
    <!-- 목록의 선호 브랜드 ★ -->
    <color name="preferred_star">#FFB45309</color>
    <!-- 즐겨찾기 북마크 표시 -->
    <color name="favorite_bookmark">#FF557300</color>
    <!-- 즐겨찾기 탭에서 왼쪽으로 밀 때 뒤 배경 -->
    <color name="swipe_delete_background">#FFD42A33</color>
    <color name="swipe_delete_icon">#FFFFFFFF</color>

    <!-- 홈 화면 위젯. 휴대폰 시스템의 다크 모드를 따르고, 어두운 색은 values-night에 있다. -->
    <color name="widget_background">#FFFFFFFF</color>
    <color name="widget_text_primary">#FF111111</color>
    <color name="widget_text_secondary">#FF636A75</color>
    <color name="widget_icon">#FF636A75</color>
    <color name="widget_saving_gain">#FF0B7D3E</color>
    <color name="widget_saving_similar">#FF636A75</color>
    <color name="widget_saving_loss">#FFD42A33</color>
    <color name="widget_update_failed">#FFD42A33</color>

    <!-- 상세 화면 7일 가격 추이 그래프 (다크 모드는 values-night) -->
    <color name="trend_line">#FF557300</color>
    <color name="trend_point">#FF557300</color>
    <color name="trend_point_hole">#FFFFFFFF</color>
    <color name="trend_baseline">#FFDDE1E6</color>
    <color name="trend_value_text">#FF111111</color>
    <color name="trend_axis_text">#FF636A75</color>
</resources>

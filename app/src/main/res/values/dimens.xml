<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        글자 크기 단계. 크기는 이 이름으로만 쓰고, 굵기와 글꼴은 styles.xml의 TextAppearance.FindCheapGas.*가 정한다.
        큰 숫자(예상 이득 금액) > 화면 제목 > 카드 제목 > 구역 제목 > 본문 > 보조 > 작은 글씨
    -->
    <dimen name="text_number">28sp</dimen>
    <dimen name="text_screen_title">22sp</dimen>
    <dimen name="text_card_title">17sp</dimen>
    <dimen name="text_section_title">15sp</dimen>
    <dimen name="text_body">16sp</dimen>
    <dimen name="text_body_small">14sp</dimen>
    <dimen name="text_caption">12sp</dimen>
    <dimen name="text_label">15sp</dimen>
    <dimen name="text_label_medium">13sp</dimen>
    <dimen name="text_label_small">12sp</dimen>

    <!-- 여백 단계. 레이아웃의 margin, padding은 이 이름으로만 쓴다. -->
    <dimen name="space_xxs">2dp</dimen>
    <dimen name="space_xs">4dp</dimen>
    <dimen name="space_s">8dp</dimen>
    <dimen name="space_m">12dp</dimen>
    <dimen name="space_l">16dp</dimen>
    <dimen name="space_xl">20dp</dimen>
    <dimen name="space_xxl">24dp</dimen>
    <dimen name="space_xxxl">32dp</dimen>
    <dimen name="space_huge">48dp</dimen>
    <!-- 카드 안쪽 여백 -->
    <dimen name="card_padding">@dimen/space_l</dimen>
    <!-- 텍스트 버튼의 글자를 왼쪽 글자 줄에 맞출 때 버튼 안쪽 여백만큼 당긴다. -->
    <dimen name="text_button_align_offset">-12dp</dimen>

    <!-- 모서리. 칩과 검색창처럼 완전히 둥근 것은 styles.xml의 ShapeAppearance.FindCheapGas.Pill(50%)을 쓴다. -->
    <dimen name="corner_xs">4dp</dimen>
    <dimen name="corner_s">8dp</dimen>
    <dimen name="corner_button">12dp</dimen>
    <dimen name="corner_card">16dp</dimen>

    <!-- 선, 높이 -->
    <dimen name="stroke_thin">1dp</dimen>
    <!-- 주인공 카드의 테두리 (어두운 테마의 라임 테두리) -->
    <dimen name="stroke_emphasis">1.5dp</dimen>
    <dimen name="elevation_floating">2dp</dimen>
    <dimen name="elevation_sheet">8dp</dimen>

    <!-- 누르는 영역과 컨트롤 크기 -->
    <dimen name="touch_target">48dp</dimen>
    <dimen name="icon_size">24dp</dimen>
    <dimen name="chip_close_icon_size">18dp</dimen>
    <!-- 지도 필터 칩의 작은 ▼ -->
    <dimen name="chip_dropdown_icon_size">16dp</dimen>
    <!-- 검색창 안 장소 / 주유소 이름 선택 버튼: 누르는 영역은 48dp, 보이는 높이는 위아래로 이만큼 줄인 32dp -->
    <dimen name="search_mode_inset">8dp</dimen>
    <dimen name="button_height">52dp</dimen>
    <dimen name="button_height_compact">36dp</dimen>
    <dimen name="control_height_compact">40dp</dimen>
    <dimen name="list_row_min_height">56dp</dimen>
    <dimen name="list_row_min_height_large">64dp</dimen>
    <dimen name="drag_handle_min_height">24dp</dimen>
    <dimen name="progress_size_small">24dp</dimen>
    <dimen name="progress_size">32dp</dimen>
    <dimen name="progress_track_corner">2dp</dimen>

    <!-- 목록 배지 ("이득 1위", "최저가", "할인 적용"), 순위 원 -->
    <dimen name="badge_padding_horizontal">6dp</dimen>
    <dimen name="badge_padding_vertical">1dp</dimen>
    <dimen name="rank_badge_size">28dp</dimen>
    <!-- 지도 색 범례 점 -->
    <dimen name="legend_dot_size">10dp</dimen>

    <!--
        주유소 목록 시트를 접었을 때 높이: 손잡이 + 이득 1위 카드.
        카드 높이는 글꼴 크기와 내용에 따라 달라서, 화면이 그려지면 코드에서 카드 높이를 재서 다시 맞춘다. 이 값은 처음 그릴 때만 쓴다.
    -->
    <dimen name="station_sheet_peek_height">232dp</dimen>
    <!-- 시트를 끝까지 올려도 검색창, 필터 줄과 지도 일부가 보인다. -->
    <dimen name="station_sheet_expanded_offset">152dp</dimen>

    <!-- 지도 위 주유소 가격 마커 (비트맵으로 그려서 글꼴 크기 설정과 관계없이 dp 기준) -->
    <dimen name="marker_text_size">13dp</dimen>
    <dimen name="marker_padding_horizontal">9dp</dimen>
    <dimen name="marker_padding_vertical">5dp</dimen>
    <dimen name="marker_tail_height">6dp</dimen>
    <dimen name="marker_tail_half_width">5dp</dimen>
    <dimen name="marker_border">1dp</dimen>
    <dimen name="marker_border_selected">2.5dp</dimen>
    <!-- 지도 위 내 위치 점 -->
    <dimen name="my_location_dot_size">22dp</dimen>
    <dimen name="my_location_border">3dp</dimen>
    <dimen name="my_location_shadow">1dp</dimen>

    <!-- 홈 화면 위젯 -->
    <dimen name="widget_corner_radius">@dimen/corner_card</dimen>
    <dimen name="widget_padding">12dp</dimen>
    <dimen name="widget_small_padding">8dp</dimen>
    <dimen name="widget_refresh_size">32dp</dimen>
    <dimen name="widget_refresh_padding">6dp</dimen>
    <dimen name="widget_gap">2dp</dimen>
    <dimen name="widget_text_title">13sp</dimen>
    <dimen name="widget_text_status">11sp</dimen>
    <dimen name="widget_text_name">16sp</dimen>
    <dimen name="widget_text_price">18sp</dimen>
    <dimen name="widget_text_saving">14sp</dimen>
    <dimen name="widget_text_detail">12sp</dimen>
    <dimen name="widget_text_footer">11sp</dimen>
    <dimen name="widget_text_message">14sp</dimen>
    <dimen name="widget_small_text_name">14sp</dimen>
    <dimen name="widget_small_text_price">13sp</dimen>

    <!-- 상세 화면 7일 가격 추이 그래프 -->
    <dimen name="trend_chart_height">180dp</dimen>
    <dimen name="trend_value_text">12sp</dimen>
    <dimen name="trend_axis_text">11sp</dimen>
    <dimen name="trend_line_width">2dp</dimen>
    <dimen name="trend_baseline_width">1dp</dimen>
    <dimen name="trend_point_radius">3.5dp</dimen>
    <dimen name="trend_last_point_radius">5dp</dimen>
    <dimen name="trend_label_gap">6dp</dimen>
    <dimen name="trend_side_padding">2dp</dimen>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 지도 위 필터 줄의 칩: 누르면 선택 메뉴가 열리고, 오른쪽에 ▼ 표시 -->
    <style name="Widget.FindCheapGas.FilterDropdownChip" parent="Widget.Material3.Chip.Assist.Elevated">
        <item name="closeIcon">@drawable/ic_arrow_drop_down</item>
        <item name="closeIconVisible">true</item>
        <item name="closeIconSize">20dp</item>
        <item name="closeIconStartPadding">0dp</item>
        <item name="android:checkable">false</item>
    </style>

    <!-- 상세 화면의 구역 제목 (주소, 전화, 유종별 가격, 부가시설) -->
    <style name="Widget.FindCheapGas.DetailSectionTitle" parent="">
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <!-- 설정 탭의 구역 제목 (내 차 정보, 다른 설정) -->
    <style name="Widget.FindCheapGas.SettingsSectionTitle" parent="">
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!--
    주변 주유소 시트 본문 (가로 화면). 화면이 낮아서 카드와 머리줄을 고정하면 목록 자리가 한 줄도 안 되므로
    카드, 머리줄, 목록을 한 덩어리로 스크롤한다. 목록(RecyclerView)은 스스로 스크롤하지 않고 내용만큼 높이를 갖는다.
    맨 위에서 아래로 끌면 NestedScrollView가 스크롤을 시트에 넘겨 시트가 내려간다.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/station_scroll"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!--
            이득 1위 카드. 실제 예상 이득 1위(선호 브랜드 정렬 보너스 없이)를 보여주고, 마커를 누르면 그 주유소로 바뀐다.
            불러오는 중, 주유소 없음, 오류, 위치 권한 안내도 이 자리에서 한 줄 안내와 버튼으로 보여준다.
        -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/best_card"
            style="@style/Widget.FindCheapGas.Card.Hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_l"
            android:layout_marginEnd="@dimen/space_l"
            android:layout_marginBottom="@dimen/space_m">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- 주유소를 보여줄 때의 본문 (세로 / 가로 화면 배치가 다름) -->
                <include layout="@layout/view_best_card_content" />

                <!-- 불러오는 중, 주유소 없음, 오류, 위치 권한·기기 위치 안내 -->
                <LinearLayout
                    android:id="@+id/best_card_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/list_row_min_height_large"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/card_padding"
                    android:paddingTop="@dimen/space_m"
                    android:paddingEnd="@dimen/card_padding"
                    android:paddingBottom="@dimen/space_m"
                    android:visibility="gone">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/best_card_status_progress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_m"
                        android:indeterminate="true"
                        app:indicatorSize="@dimen/progress_size_small" />

                    <TextView
                        android:id="@+id/best_card_status_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        tools:text="주변 주유소를 불러오고 있어요" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/best_card_status_button"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        tools:text="@string/station_retry" />
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 목록 머리줄: 왼쪽 "주변 23곳 · 내 위치 기준", 오른쪽 정렬 버튼과 마커 색 안내 (?) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_xl"
            android:paddingEnd="@dimen/space_xs">

            <TextView
                android:id="@+id/station_sheet_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                tools:text="주변 23곳 · 내 위치 기준" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sort"
                style="@style/Widget.FindCheapGas.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingStart="@dimen/space_s"
                android:paddingEnd="@dimen/space_xs"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                app:icon="@drawable/ic_arrow_drop_down"
                app:iconGravity="end"
                app:iconPadding="0dp"
                tools:text="예상 이득순" />

            <ImageButton
                android:id="@+id/btn_legend"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/map_legend_description"
                android:src="@drawable/ic_help_outline" />
        </LinearLayout>

        <!-- 목록 카드. 시트를 올리면 이득 1위 카드 아래로 이어진다. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/station_list_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_l"
            android:layout_marginStart="@dimen/space_l"
            android:layout_marginEnd="@dimen/space_l">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/station_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/space_s"
                tools:listitem="@layout/view_list_row_amount" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

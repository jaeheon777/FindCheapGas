<?xml version="1.0" encoding="utf-8"?>
<!--
    내 차 정보 입력 화면. 처음 실행할 때와 수정할 때 같은 화면을 쓴다.
    - 처음 실행: 큰 제목 "내 차 정보를 알려주세요", 한 줄 설명, 연비, 주유량, 유종 칩, 건너뛰기 안내
      / 아래 고정 [저장하고 시작하기](전체 폭) + [건너뛰기](텍스트 버튼)
    - 수정: 위쪽 뒤로 버튼, 큰 제목 "내 차 정보 수정", 한 줄 설명, 연비, 주유량 / [저장] + [취소]
    입력칸마다 아래에 작은 안내 글자를 둔다(helperText).
    버튼은 스크롤 밖 아래에 두고, 화면이 키보드 높이만큼 줄어들어(adjustResize) 버튼이 키보드 위에 보인다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/onboarding_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:visibility="gone"
        app:navigationContentDescription="@string/car_info_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        tools:visibility="visible" />

    <ScrollView
        android:id="@+id/onboarding_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/space_l">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_xxl"
            android:paddingEnd="@dimen/space_xxl">

            <!-- 처음 실행은 위쪽 여백을 크게, 수정 화면은 툴바 아래라 작게 (코드에서 바꿈) -->
            <TextView
                android:id="@+id/onboarding_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_huge"
                android:text="@string/onboarding_heading"
                android:textAppearance="?attr/textAppearanceHeadlineLarge" />

            <TextView
                android:id="@+id/onboarding_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/onboarding_description"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_fuel_efficiency_layout"
                style="?attr/textInputOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxxl"
                android:hint="@string/car_info_fuel_efficiency"
                app:helperText="@string/car_info_fuel_efficiency_helper"
                app:helperTextEnabled="true"
                app:placeholderText="@string/car_info_fuel_efficiency_placeholder"
                app:suffixText="@string/car_info_fuel_efficiency_unit">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_fuel_efficiency"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="numberDecimal"
                    android:maxLength="5" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_fuel_amount_layout"
                style="?attr/textInputOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:hint="@string/car_info_fuel_amount"
                app:helperText="@string/car_info_fuel_amount_helper"
                app:helperTextEnabled="true"
                app:placeholderText="@string/car_info_fuel_amount_placeholder"
                app:suffixText="@string/car_info_fuel_amount_unit">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_fuel_amount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:maxLength="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 처음 실행할 때만 보인다. 수정 화면에서 유종을 바꾸면 지도 탭이 다시 조회해야 해서 넣지 않는다. -->
            <LinearLayout
                android:id="@+id/onboarding_fuel_type_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxl"
                    android:text="@string/car_info_fuel_type"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/onboarding_fuel_type_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    app:selectionRequired="true"
                    app:singleSelection="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/car_info_fuel_type_helper"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxl"
                    android:text="@string/onboarding_skip_note"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 아래 고정 버튼: 전체 폭 주요 버튼(라임) 아래에 텍스트 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_xxl"
        android:paddingTop="@dimen/space_s"
        android:paddingEnd="@dimen/space_xxl"
        android:paddingBottom="@dimen/space_s">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/onboarding_primary_button"
            style="@style/Widget.FindCheapGas.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="@string/onboarding_save" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/onboarding_secondary_button"
            style="@style/Widget.FindCheapGas.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            tools:text="@string/onboarding_skip" />
    </LinearLayout>

</LinearLayout>

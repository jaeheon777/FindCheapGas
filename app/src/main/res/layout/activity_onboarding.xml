<?xml version="1.0" encoding="utf-8"?>
<!--
    내 차 정보 입력 화면. 처음 실행할 때와 수정할 때 같이 쓴다.
    - 처음 실행: 제목, 설명, 연비, 주유량, 유종, 건너뛰기 안내 / [건너뛰기] [저장하고 시작]
    - 수정: 위쪽 툴바, 설명, 연비, 주유량 / [취소] [저장]
    버튼 줄은 스크롤 밖 아래에 두고, 화면이 키보드 높이만큼 줄어들어(adjustResize) 버튼이 키보드 위에 보인다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/onboarding_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:visibility="gone"
        app:navigationContentDescription="@string/car_info_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/car_info_edit_title"
        tools:visibility="visible" />

    <ScrollView
        android:id="@+id/onboarding_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <TextView
                android:id="@+id/onboarding_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:text="@string/onboarding_heading"
                android:textAppearance="?attr/textAppearanceHeadlineSmall" />

            <TextView
                android:id="@+id/onboarding_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/onboarding_description"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_fuel_efficiency_layout"
                style="?attr/textInputOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:hint="@string/car_info_fuel_efficiency"
                app:helperText="@string/car_info_fuel_efficiency_helper"
                app:helperTextEnabled="true"
                app:placeholderText="@string/car_info_fuel_efficiency_placeholder"
                app:suffixText="@string/car_info_fuel_efficiency_unit">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_fuel_efficiency"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="numberDecimal"
                    android:maxLength="5" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_fuel_amount_layout"
                style="?attr/textInputOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/car_info_fuel_amount"
                app:helperText="@string/car_info_fuel_amount_helper"
                app:helperTextEnabled="true"
                app:placeholderText="@string/car_info_fuel_amount_placeholder"
                app:suffixText="@string/car_info_fuel_amount_unit">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_fuel_amount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:maxLength="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 처음 실행할 때만 보인다. 수정 화면에서 유종을 바꾸면 지도 탭이 다시 조회해야 해서 넣지 않는다. -->
            <LinearLayout
                android:id="@+id/onboarding_fuel_type_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/car_info_fuel_type"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/onboarding_fuel_type_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:selectionRequired="true"
                    app:singleSelection="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/car_info_fuel_type_helper"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/onboarding_skip_note"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 버튼 줄: 왼쪽 건너뛰기/취소, 오른쪽 저장 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/onboarding_secondary_button"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="@string/onboarding_skip" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/onboarding_primary_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            tools:text="@string/onboarding_save" />
    </LinearLayout>

</LinearLayout>

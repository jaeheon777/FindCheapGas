<?xml version="1.0" encoding="utf-8"?>
<!--
    주유소 목록 한 줄: 순위, 상호(선호 브랜드면 앞에 ★), 브랜드 · 거리,
    배지("이득 1위", "최저가", "100원 할인 적용"), 가격, 예상 이득
    배지는 상호 아래 한 줄에 나란히 놓아서 여러 개가 한 곳에 붙어도 가격 쪽이 좁아지지 않게 한다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_station_item"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/station_rank"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_station_rank"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        tools:text="1" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 선호 브랜드면 코드에서 앞에 ★(ic_star_small)를 붙인다. -->
        <TextView
            android:id="@+id/station_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="4dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            app:drawableTint="@color/preferred_star"
            tools:drawableStart="@drawable/ic_star_small"
            tools:text="역삼셀프주유소" />

        <TextView
            android:id="@+id/station_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="SK에너지 · 0.4km" />

        <!-- 배지 줄: 해당하는 배지가 없으면 줄 전체를 숨긴다. -->
        <LinearLayout
            android:id="@+id/station_badges"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/station_best"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_best_badge"
                android:paddingStart="6dp"
                android:paddingTop="1dp"
                android:paddingEnd="6dp"
                android:paddingBottom="1dp"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/badge_best_text"
                tools:text="@string/station_best" />

            <TextView
                android:id="@+id/station_cheapest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_cheapest_badge"
                android:paddingStart="6dp"
                android:paddingTop="1dp"
                android:paddingEnd="6dp"
                android:paddingBottom="1dp"
                android:text="@string/station_cheapest"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/badge_cheapest" />

            <TextView
                android:id="@+id/station_discount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_discount_badge"
                android:paddingStart="6dp"
                android:paddingTop="1dp"
                android:paddingEnd="6dp"
                android:paddingBottom="1dp"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/badge_discount"
                tools:text="100원 할인 적용" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/station_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textStyle="bold"
            tools:text="1,659원" />

        <TextView
            android:id="@+id/station_saving"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            tools:text="약 1,925원 이득" />
    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
    내 브랜드 수정 시트 (내 브랜드 목록의 줄을 누르면 열림).
    리터당 할인, 1회 할인 한도(비우면 회색 "한도 미적용"), 카드사 조건 안내, 선호, 숨기기 / [할인 지우기] [취소] [저장]
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/brand_edit_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleLarge" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/brand_edit_per_liter_layout"
            style="?attr/textInputOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/brand_edit_per_liter"
            app:expandedHintEnabled="false"
            app:helperText="@string/brand_edit_per_liter_helper"
            app:helperTextEnabled="true"
            app:placeholderText="@string/brand_edit_per_liter_placeholder"
            app:suffixText="@string/brand_edit_per_liter_unit">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/brand_edit_per_liter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="number"
                android:maxLength="4" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 비어 있으면 회색 "한도 미적용"이 항상 보이도록 힌트를 위로 올려 둔다 (expandedHintEnabled=false). -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/brand_edit_cap_layout"
            style="?attr/textInputOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/brand_edit_cap"
            app:expandedHintEnabled="false"
            app:helperText="@string/brand_edit_cap_helper"
            app:helperTextEnabled="true"
            app:placeholderText="@string/brand_edit_cap_placeholder"
            app:suffixText="@string/brand_edit_cap_unit">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/brand_edit_cap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:maxLength="7" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/brand_edit_conditions_note"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/brand_edit_preferred"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:text="@string/brand_edit_preferred"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/brand_edit_preferred_helper"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/brand_edit_hidden"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/brand_edit_hidden"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/brand_edit_hidden_helper"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 저장된 할인이나 한도가 있을 때만 보인다. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/brand_edit_clear_discount"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/brand_edit_clear_discount" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/brand_edit_cancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/brand_edit_cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/brand_edit_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/brand_edit_save" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

<?xml version="1.0" encoding="utf-8"?>
<!--
    홈 화면 위젯 (가로 4칸 · 세로 2칸 기본). 작게 줄이면 widget_station_small을 쓴다.
    주유소 내용(widget_content)과 안내 문구(widget_message) 중 하나만 보인다. WidgetRenderer가 채운다.
    루트 ID를 @android:id/background로 두면 Android 12 이상에서 런처의 모서리 모양에 맞게 잘린다.
    글꼴은 앱과 같은 Pretendard다. 위젯에서 글꼴 리소스는 Android 8.0 이상에서만 읽혀서 그 아래 버전은 시스템 글꼴로 보인다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/widget_title_home"
            android:fontFamily="@font/app_font"
            android:textColor="@color/widget_text_secondary"
            android:textSize="@dimen/widget_text_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:fontFamily="@font/app_font"
            android:textColor="@color/widget_update_failed"
            android:textSize="@dimen/widget_text_status" />

        <ImageView
            android:id="@+id/widget_refresh"
            android:layout_width="@dimen/widget_refresh_size"
            android:layout_height="@dimen/widget_refresh_size"
            android:layout_marginStart="@dimen/space_xs"
            android:contentDescription="@string/widget_refresh"
            android:padding="@dimen/widget_refresh_padding"
            android:src="@drawable/ic_widget_refresh" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_station_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:fontFamily="@font/app_font"
            android:textColor="@color/widget_text_primary"
            android:textSize="@dimen/widget_text_name"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/widget_gap"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="@font/app_font"
                android:textColor="@color/widget_text_primary"
                android:textSize="@dimen/widget_text_price"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_saving"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:fontFamily="@font/app_font"
                android:textColor="@color/widget_saving_gain"
                android:textSize="@dimen/widget_text_saving"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/widget_gap"
            android:ellipsize="end"
            android:maxLines="1"
            android:fontFamily="@font/app_font"
            android:textColor="@color/widget_text_secondary"
            android:textSize="@dimen/widget_text_detail" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_message"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="3"
        android:text="@string/widget_loading"
        android:fontFamily="@font/app_font"
        android:textColor="@color/widget_text_primary"
        android:textSize="@dimen/widget_text_message" />

    <TextView
        android:id="@+id/widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:fontFamily="@font/app_font"
        android:textColor="@color/widget_text_secondary"
        android:textSize="@dimen/widget_text_footer"
        android:visibility="gone" />
</LinearLayout>

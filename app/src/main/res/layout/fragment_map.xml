<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 카카오맵 MapView는 SDK 초기화에 성공했을 때만 코드에서 넣는다. -->
    <FrameLayout
        android:id="@+id/map_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 지도를 쓸 수 없거나 지도 오류가 났을 때 안내 -->
    <TextView
        android:id="@+id/map_message"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground"
        android:gravity="center"
        android:padding="@dimen/space_xxl"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:visibility="gone" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/location_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:indeterminate="true"
        android:visibility="gone" />

    <!--
        지도 위쪽 영역. 위에서부터 차례로 쌓여서 서로 겹치지 않는다.
        - 검색창: [장소 | 주유소 이름] 선택, 검색어, 검색 버튼 (검색 버튼이나 키보드의 검색 키를 눌렀을 때만 검색)
        - 필터 줄: 조회 위치 칩(검색한 장소 기준일 때만), 유종, 반경, 브랜드 빠른 필터
        - 위치 권한 / 기기 위치 안내
        - 이 지역에서 다시 검색 버튼 (가운데)
    -->
    <LinearLayout
        android:id="@+id/map_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingTop="@dimen/space_s">

        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewElevatedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:layout_marginEnd="@dimen/space_m"
            android:layout_marginBottom="@dimen/space_s"
            app:shapeAppearance="@style/ShapeAppearance.FindCheapGas.Pill">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_s"
                android:paddingEnd="@dimen/space_xs">

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/search_mode_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:checkedButton="@id/search_mode_place"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/search_mode_place"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/control_height_compact"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:paddingStart="@dimen/space_m"
                        android:paddingEnd="@dimen/space_m"
                        android:text="@string/search_mode_place"
                        android:textAppearance="?attr/textAppearanceLabelMedium" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/search_mode_station"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/control_height_compact"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:paddingStart="@dimen/space_m"
                        android:paddingEnd="@dimen/space_m"
                        android:text="@string/search_mode_station"
                        android:textAppearance="?attr/textAppearanceLabelMedium" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <EditText
                    android:id="@+id/search_input"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_target"
                    android:layout_marginStart="@dimen/space_s"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/search_hint_place"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <ImageButton
                    android:id="@+id/search_button"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/search_button"
                    android:src="@drawable/ic_search" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingStart="@dimen/space_m"
            android:paddingEnd="@dimen/space_m"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/filter_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- 검색한 장소·주유소, 지도 중심 기준으로 조회 중일 때만 보인다. X를 누르면 내 위치 기준으로 돌아간다. -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_origin"
                    style="@style/Widget.FindCheapGas.OriginChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_s"
                    android:visibility="gone"
                    tools:text="강남역 기준"
                    tools:visibility="visible" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_fuel_type"
                    style="@style/Widget.FindCheapGas.FilterDropdownChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="휘발유" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_radius"
                    style="@style/Widget.FindCheapGas.FilterDropdownChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    tools:text="반경 3km" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_brand"
                    style="@style/Widget.FindCheapGas.FilterDropdownChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    tools:text="브랜드: 전체" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- 위치 권한 거부, 기기 위치 꺼짐 안내 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/location_banner"
            style="?attr/materialCardViewElevatedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:layout_marginTop="@dimen/space_s"
            android:layout_marginEnd="@dimen/space_m"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_l"
                android:paddingTop="@dimen/space_s"
                android:paddingEnd="@dimen/space_s"
                android:paddingBottom="@dimen/space_s">

                <TextView
                    android:id="@+id/location_banner_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/location_banner_button"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!--
            이 지역에서 다시 검색. 지도 이동이 끝났을 때 지도 중심이 조회 위치에서 고른 반경(최대 3km) 이상 떨어져 있으면 코드에서 보이게 한다.
            누르면 지도 중심을 조회 위치로 다시 조회하고 숨긴다.
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_research"
            style="@style/Widget.Material3.Button.ElevatedButton.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/research_here"
            android:visibility="gone"
            app:icon="@drawable/ic_refresh"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- 주변 주유소 목록. 접힌 상태 → 절반 → 거의 전체로 끌어올릴 수 있다. -->
    <LinearLayout
        android:id="@+id/station_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_station_sheet"
        android:elevation="@dimen/elevation_sheet"
        android:orientation="vertical"
        app:behavior_expandedOffset="@dimen/station_sheet_expanded_offset"
        app:behavior_fitToContents="false"
        app:behavior_halfExpandedRatio="0.5"
        app:behavior_hideable="false"
        app:behavior_peekHeight="@dimen/station_sheet_peek_height"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/drag_handle_min_height"
            android:paddingTop="@dimen/space_s"
            android:paddingBottom="@dimen/space_s" />

        <!-- 제목 줄: 왼쪽에 제목과 조건 문구, 오른쪽에 정렬 버튼 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_l"
            android:paddingEnd="@dimen/space_s"
            android:paddingBottom="@dimen/space_xs">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/station_sheet_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/station_sheet_title"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <TextView
                    android:id="@+id/station_sheet_condition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="휘발유 · 3km · 가격순" />

                <!-- 계산 기준 문구 (예: 연비 12km/L · 40L 기준 (기본값)), 누르면 내 차 정보 수정 화면 -->
                <TextView
                    android:id="@+id/station_sheet_basis"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:drawablePadding="@dimen/space_xxs"
                    android:gravity="center_vertical"
                    android:paddingTop="@dimen/space_xs"
                    android:paddingBottom="@dimen/space_xs"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorPrimary"
                    app:drawableEndCompat="@drawable/ic_chevron_right"
                    app:drawableTint="?attr/colorPrimary"
                    tools:text="연비 12km/L · 40L 기준 (기본값)" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sort"
                style="@style/Widget.FindCheapGas.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/control_height_compact"
                android:minWidth="0dp"
                android:paddingStart="@dimen/space_s"
                android:paddingEnd="@dimen/space_xs"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                app:icon="@drawable/ic_arrow_drop_down"
                app:iconGravity="end"
                app:iconPadding="0dp"
                tools:text="가격순" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/station_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/space_s"
                tools:listitem="@layout/item_station" />

            <!-- 불러오는 중, 주유소 없음, 오류 안내 -->
            <LinearLayout
                android:id="@+id/station_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/space_l"
                android:visibility="gone">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/station_status_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_s"
                    android:indeterminate="true"
                    app:indicatorSize="@dimen/progress_size_small" />

                <TextView
                    android:id="@+id/station_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/station_retry_button"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="@string/station_retry" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!--
        마커 색 범례. 내 위치 버튼의 반대쪽(시트 위쪽 왼쪽 끝)에 붙어서 시트와 함께 움직인다.
        시트를 끝까지 올리면 필터 줄과 겹치지 않게 코드에서 숨긴다. 색만으로 구분하지 않도록 글자를 함께 쓴다.
    -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/map_legend"
        style="?attr/materialCardViewElevatedStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="@dimen/space_m"
        android:layout_marginBottom="@dimen/space_m"
        android:contentDescription="@string/map_legend_description"
        android:importantForAccessibility="yes"
        app:cardCornerRadius="@dimen/corner_button"
        app:layout_anchor="@id/station_sheet"
        app:layout_anchorGravity="top|start">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_m"
            android:paddingTop="@dimen/space_xs"
            android:paddingEnd="@dimen/space_m"
            android:paddingBottom="@dimen/space_xs">

            <TextView
                style="@style/Widget.FindCheapGas.MapLegendItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/map_legend_gain"
                app:drawableTint="@color/marker_gain_background" />

            <TextView
                style="@style/Widget.FindCheapGas.MapLegendItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:text="@string/map_legend_similar"
                app:drawableTint="@color/marker_similar_background" />

            <TextView
                style="@style/Widget.FindCheapGas.MapLegendItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:text="@string/map_legend_loss"
                app:drawableTint="@color/marker_loss_background" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:text="@string/map_legend_threshold"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 목록 시트 위쪽 끝에 붙어서 시트와 함께 움직인다. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_my_location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="@dimen/space_l"
        android:contentDescription="@string/my_location"
        app:fabSize="mini"
        app:layout_anchor="@id/station_sheet"
        app:layout_anchorGravity="top|end"
        app:srcCompat="@drawable/ic_my_location" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>

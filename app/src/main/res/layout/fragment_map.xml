<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--
        카카오맵 MapView는 SDK 초기화에 성공했을 때만 코드에서 넣는다.
        아래 시트를 올린 동안 지도를 누르면 시트만 내리고 지도에는 누름을 넘기지 않는다 (MapTouchGuardLayout).
    -->
    <com.example.findcheapgas.ui.map.MapTouchGuardLayout
        android:id="@+id/map_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 지도를 쓸 수 없거나 지도 오류가 났을 때 안내 -->
    <TextView
        android:id="@+id/map_message"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground"
        android:gravity="center"
        android:padding="@dimen/space_xxl"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:visibility="gone" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/location_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:indeterminate="true"
        android:visibility="gone" />

    <!--
        지도 위쪽 영역. 위에서부터 차례로 쌓여서 서로 겹치지 않는다.
        - 검색창: [장소 | 주유소 이름] 작은 선택 버튼, 검색어, 검색 버튼 (검색 버튼이나 키보드의 검색 키를 눌렀을 때만 검색)
        - 필터 줄: 조회 위치 칩(검색한 장소 기준일 때만), 유종("휘발유"), 반경("5km"), 브랜드("브랜드", "브랜드 2", "할인 브랜드")
        - 이 지역에서 다시 검색 버튼 (가운데)
        위치 권한 / 기기 위치 안내는 시트의 이득 1위 카드 자리에서 보여준다.
    -->
    <LinearLayout
        android:id="@+id/map_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingTop="@dimen/space_s">

        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewElevatedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:layout_marginEnd="@dimen/space_m"
            android:layout_marginBottom="@dimen/space_s"
            app:shapeAppearance="@style/ShapeAppearance.FindCheapGas.Pill">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_s"
                android:paddingEnd="@dimen/space_xs">

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/search_mode_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:checkedButton="@id/search_mode_place"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/search_mode_place"
                        style="@style/Widget.FindCheapGas.Button.SearchMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/search_mode_place" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/search_mode_station"
                        style="@style/Widget.FindCheapGas.Button.SearchMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/search_mode_station" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <EditText
                    android:id="@+id/search_input"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_target"
                    android:layout_marginStart="@dimen/space_s"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/search_hint_place"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <ImageButton
                    android:id="@+id/search_button"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/search_button"
                    android:src="@drawable/ic_search" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <HorizontalScrollView
            android:id="@+id/filter_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingStart="@dimen/space_m"
            android:paddingEnd="@dimen/space_m"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/filter_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- 검색한 장소·주유소, 지도 중심 기준으로 조회 중일 때만 보인다. X를 누르면 내 위치 기준으로 돌아간다. -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_origin"
                    style="@style/Widget.FindCheapGas.OriginChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_s"
                    android:visibility="gone"
                    tools:text="강남역 기준"
                    tools:visibility="visible" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_fuel_type"
                    style="@style/Widget.FindCheapGas.FilterDropdownChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="휘발유" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_radius"
                    style="@style/Widget.FindCheapGas.FilterDropdownChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    tools:text="3km" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_brand"
                    style="@style/Widget.FindCheapGas.FilterDropdownChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    tools:text="브랜드" />
            </LinearLayout>
        </HorizontalScrollView>

        <!--
            이 지역에서 다시 검색. 지도 이동이 끝났을 때 지도 중심이 조회 위치에서 고른 반경(최대 3km) 이상 떨어져 있으면 코드에서 보이게 한다.
            누르면 지도 중심을 조회 위치로 다시 조회하고 숨긴다. 시트를 내린 상태보다 올리면 흐려지다가 숨고, 다시 내리면 돌아온다.
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_research"
            style="@style/Widget.Material3.Button.ElevatedButton.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/research_here"
            android:visibility="gone"
            app:icon="@drawable/ic_refresh"
            tools:visibility="visible" />
    </LinearLayout>

    <!--
        주변 주유소 시트. 회색 바탕 위에 위에서부터 손잡이, 이득 1위 카드, 목록 머리줄, 목록 카드를 쌓는다.
        - 접힌 상태(peek)에서는 손잡이와 이득 1위 카드만 보인다. peek 높이와 지도 아래 여백은 코드에서 카드 높이를 재서 맞춘다.
        - 시트를 올리면 카드는 맨 위에 그대로 있고 그 아래로 목록이 이어진다.
        - 내림 / 올림 두 단계만 둔다 (fitToContents라 가운데 단계 없음). 시트 높이는 코드에서 화면 높이 - station_sheet_expanded_offset으로
          맞춰서, 끝까지 올리면 검색창과 필터 줄 아래(가로 화면은 검색창 아래)에서 멈춘다. 손잡이를 누르면 내림 ↔ 올림이 바뀐다.
        - 가로 화면이나 큰 글꼴처럼 그 높이가 접힌 상태(peek)보다 작으면 카드가 잘리지 않게 코드에서 시트를 peek 이상으로 키운다.
    -->
    <LinearLayout
        android:id="@+id/station_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_station_sheet"
        android:elevation="@dimen/elevation_sheet"
        android:orientation="vertical"
        app:behavior_fitToContents="true"
        app:behavior_hideable="false"
        app:behavior_peekHeight="@dimen/station_sheet_peek_height"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <!-- 손잡이: 끌어서 올리고 내리거나, 누르면 내림 ↔ 올림. 접근성 설명은 코드에서 "목록 펼치기" / "목록 접기"로 바꾼다. -->
        <ImageView
            android:id="@+id/station_sheet_handle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/sheet_handle_expand"
            android:minHeight="@dimen/drag_handle_min_height"
            android:paddingTop="@dimen/space_s"
            android:paddingBottom="@dimen/space_s"
            android:scaleType="center"
            android:src="@drawable/bg_sheet_handle" />

        <!--
            이득 1위 카드. 실제 예상 이득 1위(선호 브랜드 정렬 보너스 없이)를 보여주고, 마커를 누르면 그 주유소로 바뀐다.
            불러오는 중, 주유소 없음, 오류, 위치 권한 안내도 이 자리에서 한 줄 안내와 버튼으로 보여준다.
        -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/best_card"
            style="@style/Widget.FindCheapGas.Card.Hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_l"
            android:layout_marginEnd="@dimen/space_l"
            android:layout_marginBottom="@dimen/space_m">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- 주유소를 보여줄 때의 본문 (세로 / 가로 화면 배치가 다름) -->
                <include layout="@layout/view_best_card_content" />

                <!-- 불러오는 중, 주유소 없음, 오류, 위치 권한·기기 위치 안내 -->
                <LinearLayout
                    android:id="@+id/best_card_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/list_row_min_height_large"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/card_padding"
                    android:paddingTop="@dimen/space_m"
                    android:paddingEnd="@dimen/card_padding"
                    android:paddingBottom="@dimen/space_m"
                    android:visibility="gone">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/best_card_status_progress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_m"
                        android:indeterminate="true"
                        app:indicatorSize="@dimen/progress_size_small" />

                    <TextView
                        android:id="@+id/best_card_status_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        tools:text="주변 주유소를 불러오고 있어요" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/best_card_status_button"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        tools:text="@string/station_retry" />
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 목록 머리줄: 왼쪽 "주변 23곳 · 내 위치 기준", 오른쪽 정렬 버튼과 마커 색 안내 (?) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_xl"
            android:paddingEnd="@dimen/space_xs">

            <TextView
                android:id="@+id/station_sheet_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                tools:text="주변 23곳 · 내 위치 기준" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sort"
                style="@style/Widget.FindCheapGas.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingStart="@dimen/space_s"
                android:paddingEnd="@dimen/space_xs"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                app:icon="@drawable/ic_arrow_drop_down"
                app:iconGravity="end"
                app:iconPadding="0dp"
                tools:text="예상 이득순" />

            <ImageButton
                android:id="@+id/btn_legend"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/map_legend_description"
                android:src="@drawable/ic_help_outline" />
        </LinearLayout>

        <!-- 목록 카드. 시트를 올리면 이득 1위 카드 아래로 이어진다. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/station_list_card"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/space_l"
            android:layout_marginEnd="@dimen/space_l">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/station_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/space_s"
                tools:listitem="@layout/view_list_row_amount" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- 목록 시트 위쪽 끝에 붙어서 시트와 함께 움직인다. 시트를 올려 지도 위쪽 필터 줄에 닿으면 코드에서 숨긴다. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_my_location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="@dimen/space_l"
        android:contentDescription="@string/my_location"
        app:fabSize="mini"
        app:layout_anchor="@id/station_sheet"
        app:layout_anchorGravity="top|end"
        app:srcCompat="@drawable/ic_my_location" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>

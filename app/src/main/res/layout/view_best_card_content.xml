<?xml version="1.0" encoding="utf-8"?>
<!--
    이득 1위 카드에서 주유소를 보여줄 때의 본문 (세로 화면). 위에서부터 "이득 1위" 줄, 주인공 숫자, 상호 / 브랜드 · 거리 · 가격과 길찾기, 계산 기준.
    가로 화면은 layout-land의 같은 이름 파일에서 두 칸으로 나눠 카드 높이를 줄인다. 두 파일의 id는 같아야 한다.
    본문을 누르면 계산 결과와 함께 상세 화면을 연다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/best_card_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/card_padding"
    android:paddingTop="@dimen/space_xxs"
    android:paddingEnd="@dimen/card_padding"
    android:paddingBottom="@dimen/space_xxs">

    <!--
        "이득 1위" 또는 "선택한 주유소", 마커로 다른 주유소를 골랐으면 오른쪽에 "이득 1위 보기".
        버튼이 나타나도 카드 높이가 바뀌지 않도록 줄 높이를 누르는 영역(48dp)으로 고정한다.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/best_card_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:minHeight="@dimen/touch_target"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorPrimary"
            tools:text="@string/best_card_label" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/best_card_show_best"
            style="@style/Widget.FindCheapGas.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/text_button_align_offset"
            android:minWidth="0dp"
            android:text="@string/best_card_show_best"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- 주인공 숫자: "약 2,583원 아낄 수 있어요" (색은 코드에서 예상 이득 구간에 맞춘다) -->
    <TextView
        android:id="@+id/best_card_headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceDisplaySmall"
        tools:text="약 2,583원 아낄 수 있어요"
        tools:textColor="@color/hero_saving_gain_text" />

    <!-- 상호 / 브랜드 · 거리 · 가격, 오른쪽에 길찾기 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/best_card_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                tools:text="역삼셀프주유소" />

            <TextView
                android:id="@+id/best_card_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="SK에너지 · 1.2km · 1,579원" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/best_card_route"
            style="@style/Widget.FindCheapGas.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:contentDescription="@string/detail_route_description"
            android:minHeight="@dimen/touch_target"
            android:text="@string/detail_route"
            app:icon="@drawable/ic_directions" />
    </LinearLayout>

    <!-- 계산 기준 문구 (예: 연비 12km/L · 40L 기준 (기본값)), 누르면 내 차 정보 수정 화면 -->
    <TextView
        android:id="@+id/best_card_basis"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:background="?attr/selectableItemBackground"
        android:drawablePadding="@dimen/space_xxs"
        android:gravity="center_vertical"
        android:minHeight="@dimen/touch_target"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:drawableEndCompat="@drawable/ic_chevron_right"
        app:drawableTint="?attr/colorOnSurfaceVariant"
        tools:text="연비 12km/L · 40L 기준 (기본값)" />
</LinearLayout>

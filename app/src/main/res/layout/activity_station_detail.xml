<?xml version="1.0" encoding="utf-8"?>
<!--
    주유소 상세 화면. 회색 바탕 위에 카드를 쌓는다. 위에서부터
    - 맨 위 카드(주인공 카드): 상호, 브랜드 · 거리, 주인공 숫자(예상 이득), 기준 주유소 이름과 계산 기준, 고른 유종 가격.
      그 아래 "계산 내역 보기"를 누르면 예상 이득 계산 내역을 펼친다 (지도 탭에서 넘겨받은 결과, 다시 계산하지 않음).
    - 상세 조회 상태: 불러오는 중, 오류와 다시 시도
    - 가격 카드: 유종별 가격 / 주유소 정보 카드: 주소, 전화, 부가시설 (상세 조회 결과가 오면 표시)
    - 평균가 대비 카드, 7일 가격 추이 카드. 상세 조회와 따로 불러온다.
    - 아래 버튼 줄: 즐겨찾기, 지도에서 보기 (즐겨찾기 탭에서 열었을 때), 길찾기
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/detail_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/detail_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/detail_title" />

    <ScrollView
        android:id="@+id/detail_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_xxl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_l"
            android:paddingEnd="@dimen/space_l">

            <!-- 맨 위 카드. 밝게는 흰 카드, 어둡게는 라임 테두리 + 라임 숫자 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FindCheapGas.Card.Hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/card_padding"
                    android:paddingTop="@dimen/card_padding"
                    android:paddingEnd="@dimen/card_padding"
                    android:paddingBottom="@dimen/space_xs">

                    <TextView
                        android:id="@+id/detail_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        tools:text="역삼셀프주유소" />

                    <TextView
                        android:id="@+id/detail_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="SK에너지 · 내 위치에서 0.4km" />

                    <!-- 주인공 숫자: "약 2,583원 아낄 수 있어요". 계산 결과가 없으면(즐겨찾기 5km 밖 등) 숨긴다. -->
                    <TextView
                        android:id="@+id/detail_headline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_l"
                        android:textAppearance="?attr/textAppearanceDisplaySmall"
                        android:visibility="gone"
                        tools:text="약 2,583원 아낄 수 있어요"
                        tools:textColor="@color/hero_saving_gain_text"
                        tools:visibility="visible" />

                    <!-- "역삼셀프주유소보다 · 내 차 기준 · 연비 15km/L · 40L" (기준 주유소 이름 + 계산 기준) -->
                    <TextView
                        android:id="@+id/detail_headline_basis"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone"
                        tools:text="역삼셀프주유소보다 · 내 차 기준 · 연비 15km/L · 40L"
                        tools:visibility="visible" />

                    <!-- 보조 숫자: 고른 유종 가격 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_l"
                        android:baselineAligned="true"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/detail_selected_fuel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            tools:text="휘발유" />

                        <TextView
                            android:id="@+id/detail_selected_price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_s"
                            android:fontFeatureSettings="tnum"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textStyle="bold"
                            tools:text="1,579원" />
                    </LinearLayout>

                    <!--
                        예상 이득 계산 내역: "계산 내역 보기"를 누르면 펼친다 (접힘 상태는 회전해도 유지).
                        계산 기준 문구, 한도 미적용, 한도 안내, 추정 안내는 펼친 안쪽에 그대로 둔다.
                        계산 결과가 없으면 버튼과 내역을 모두 숨긴다.
                    -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/detail_saving_toggle"
                        style="@style/Widget.FindCheapGas.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/text_button_align_offset"
                        android:layout_marginTop="@dimen/space_s"
                        android:text="@string/detail_saving_expand"
                        android:visibility="gone"
                        app:icon="@drawable/ic_expand_more"
                        app:iconGravity="end"
                        tools:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/detail_saving_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="@dimen/space_m"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_saving_title"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />

                        <TextView
                            android:id="@+id/detail_saving_basis"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            tools:text="연비 12km/L · 40L 기준 (기본값)" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xxs"
                            android:text="@string/detail_saving_basis_hint"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <!-- 기준 주유소를 열었을 때만 보인다. -->
                        <TextView
                            android:id="@+id/detail_saving_is_baseline"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:background="@drawable/bg_saving_notice"
                            android:padding="@dimen/space_m"
                            android:text="@string/detail_saving_is_baseline"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:visibility="gone" />

                        <!-- 계산 항목: 코드에서 한 줄씩 넣는다 (item_saving_row). -->
                        <LinearLayout
                            android:id="@+id/detail_saving_rows"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:orientation="vertical" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:text="@string/detail_saving_note"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 상세 조회 상태: 불러오는 중이거나 오류일 때만 보인다. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/detail_status"
                style="@style/Widget.FindCheapGas.DetailCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    style="@style/Widget.FindCheapGas.DetailCard.Content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/detail_status_progress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:indeterminate="true"
                        app:indicatorSize="@dimen/progress_size" />

                    <TextView
                        android:id="@+id/detail_status_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:gravity="center"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="@string/detail_loading" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/detail_retry_button"
                        style="@style/Widget.FindCheapGas.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:text="@string/station_retry" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 상세 정보: 상세 조회가 끝나면 보인다. 가격 카드, 주유소 정보 카드 -->
            <LinearLayout
                android:id="@+id/detail_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- 유종별 가격: 파는 유종만 코드에서 한 줄씩 넣는다 (item_fuel_price). -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.FindCheapGas.DetailCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        style="@style/Widget.FindCheapGas.DetailCard.Content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            style="@style/Widget.FindCheapGas.DetailCard.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_prices" />

                        <LinearLayout
                            android:id="@+id/detail_price_rows"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:orientation="vertical" />

                        <TextView
                            android:id="@+id/detail_prices_empty"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:text="@string/detail_prices_empty"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 주소, 전화, 부가시설 -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.FindCheapGas.DetailCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        style="@style/Widget.FindCheapGas.DetailCard.Content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            style="@style/Widget.FindCheapGas.DetailSectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="0dp"
                            android:text="@string/detail_address" />

                        <TextView
                            android:id="@+id/detail_address"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textIsSelectable="true"
                            tools:text="서울특별시 강남구 테헤란로 152" />

                        <!-- 전화번호: 번호가 없으면 숨긴다. 누르면 다이얼 화면이 열린다. -->
                        <LinearLayout
                            android:id="@+id/detail_phone_section"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Widget.FindCheapGas.DetailSectionTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/detail_phone" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/detail_phone"
                                style="@style/Widget.Material3.Button.TextButton.Icon"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/text_button_align_offset"
                                android:textAppearance="?attr/textAppearanceBodyLarge"
                                app:icon="@drawable/ic_phone"
                                tools:text="02-0000-0001" />
                        </LinearLayout>

                        <!-- 부가시설: 있는 것만 칩으로 표시 -->
                        <TextView
                            style="@style/Widget.FindCheapGas.DetailSectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_facilities" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/detail_facilities"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs" />

                        <TextView
                            android:id="@+id/detail_facilities_empty"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:text="@string/detail_facilities_empty"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/detail_self_note"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:text="@string/detail_self_estimated_note"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!--
                평균가 대비: 지금 고른 유종의 표시 가격(할인 전)을 전국 평균, 지역(시도) 평균과 비교한다.
                상세 조회와 따로 불러오고, 못 불러오면 이 구역만 짧은 안내로 바뀐다.
                비교 줄은 코드에서 한 줄씩 넣는다 (item_average_row).
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/detail_average_section"
                style="@style/Widget.FindCheapGas.DetailCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    style="@style/Widget.FindCheapGas.DetailCard.Content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/Widget.FindCheapGas.DetailCard.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/detail_average_title" />

                    <TextView
                        android:id="@+id/detail_average_basis"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:visibility="gone"
                        tools:text="휘발유 1,671원 · 표시 가격 기준 (할인 전)"
                        tools:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/detail_average_rows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/detail_average_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="@string/detail_average_loading" />

                    <TextView
                        android:id="@+id/detail_average_note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/detail_average_note"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!--
                7일 가격 추이: 최근 7일 전국 평균가 꺾은선 그래프와 지난 변화 한 줄.
                점이 2개 미만이거나 못 불러오면 그래프 대신 안내 문구를 보여준다.
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/detail_trend_section"
                style="@style/Widget.FindCheapGas.DetailCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    style="@style/Widget.FindCheapGas.DetailCard.Content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/Widget.FindCheapGas.DetailCard.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/detail_trend_title" />

                    <TextView
                        android:id="@+id/detail_trend_heading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        tools:text="최근 7일 전국 평균 (휘발유)" />

                    <com.example.findcheapgas.ui.detail.PriceTrendView
                        android:id="@+id/detail_trend_chart"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/trend_chart_height"
                        android:layout_marginTop="@dimen/space_s"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/detail_trend_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:visibility="gone"
                        tools:text="6일 전(10/31)보다 약 12원 올랐어요"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/detail_trend_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="@string/detail_trend_loading" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <!--
        아래 버튼 줄 (코드에서 보이게 한다)
        - 즐겨찾기: 북마크 아이콘 (채움 = 즐겨찾기됨, 비움 = 아님), 누를 때마다 추가 / 삭제
        - 지도에서 보기: 즐겨찾기 탭에서 열었을 때만 보인다.
        - 길찾기: 카카오맵 / 티맵 중 고르면 외부 앱을 열고 목적지를 넣는다 (좌표가 없으면 숨김).
    -->
    <LinearLayout
        android:id="@+id/detail_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/space_m"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/detail_favorite_button"
            style="@style/Widget.FindCheapGas.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/detail_favorite_add"
            app:icon="@drawable/ic_bookmark_border" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/detail_show_on_map_button"
            style="@style/Widget.FindCheapGas.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:layout_weight="1"
            android:text="@string/detail_show_on_map"
            android:visibility="gone"
            app:icon="@drawable/ic_map" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/detail_route_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:layout_weight="1"
            android:contentDescription="@string/detail_route_description"

<?xml version="1.0" encoding="utf-8"?>
<!--
    주유소 상세 화면. 위에서부터
    - 기본 정보: 상호, 브랜드 · 거리, 선택한 유종 가격 (목록에서 넘겨받아 바로 표시)
    - 예상 이득 계산 내역 (지도 탭에서 넘겨받아 바로 표시)
    - 상세 조회 상태: 불러오는 중, 오류와 다시 시도
    - 상세 정보: 주소, 전화, 유종별 가격, 부가시설 (상세 조회 결과가 오면 표시)
    - 나중에 들어갈 자리 (지금은 숨김)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/detail_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/detail_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/detail_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <!-- 기본 정보 (목록에서 넘겨받은 값) -->
            <TextView
                android:id="@+id/detail_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                tools:text="역삼셀프주유소" />

            <TextView
                android:id="@+id/detail_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="SK에너지 · 조회 위치에서 0.4km" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/detail_selected_fuel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    tools:text="휘발유" />

                <TextView
                    android:id="@+id/detail_selected_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textAppearance="?attr/textAppearanceHeadlineMedium"
                    android:textStyle="bold"
                    tools:text="1,659원" />
            </LinearLayout>

            <!--
                예상 이득 계산 내역: 지도 탭에서 계산한 결과를 넘겨받아 보여준다 (다시 조회하거나 계산하지 않는다).
                계산 기준 문구, 기준 주유소, 기름값, 할인액, 추정 도로 거리, 이동 비용, 예상 총비용, 기준과의 차이.
                상세 조회 결과와 상관없이 보이므로 상세 조회 상태보다 먼저 둔다.
                계산 기준은 여기서 바꿀 수 없다 (지도 탭의 계산 기준 문구나 설정 탭에서 바꾼다).
            -->
            <LinearLayout
                android:id="@+id/detail_saving_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    style="@style/Widget.FindCheapGas.DetailSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_saving_title" />

                <TextView
                    android:id="@+id/detail_saving_basis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    tools:text="연비 12km/L · 40L 기준 (기본값)" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/detail_saving_basis_hint"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <!-- 기준 주유소를 열었을 때만 보인다. -->
                <TextView
                    android:id="@+id/detail_saving_is_baseline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_saving_notice"
                    android:padding="12dp"
                    android:text="@string/detail_saving_is_baseline"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:visibility="gone" />

                <!-- 계산 항목: 코드에서 한 줄씩 넣는다 (item_saving_row). -->
                <LinearLayout
                    android:id="@+id/detail_saving_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/detail_saving_note"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <!-- 상세 조회 상태: 불러오는 중이거나 오류일 때만 보인다. -->
            <LinearLayout
                android:id="@+id/detail_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/detail_status_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    app:indicatorSize="32dp" />

                <TextView
                    android:id="@+id/detail_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="@string/detail_loading" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/detail_retry_button"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/station_retry" />
            </LinearLayout>

            <!-- 상세 정보: 상세 조회가 끝나면 보인다. -->
            <LinearLayout
                android:id="@+id/detail_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- 주소 -->
                <TextView
                    style="@style/Widget.FindCheapGas.DetailSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_address" />

                <TextView
                    android:id="@+id/detail_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textIsSelectable="true"
                    tools:text="서울특별시 강남구 테헤란로 152" />

                <!-- 전화번호: 번호가 없으면 숨긴다. 누르면 다이얼 화면이 열린다. -->
                <LinearLayout
                    android:id="@+id/detail_phone_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.FindCheapGas.DetailSectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/detail_phone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/detail_phone"
                        style="@style/Widget.Material3.Button.TextButton.Icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="-12dp"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        app:icon="@drawable/ic_phone"
                        tools:text="02-0000-0001" />
                </LinearLayout>

                <!-- 유종별 가격: 파는 유종만 코드에서 한 줄씩 넣는다 (item_fuel_price). -->
                <TextView
                    style="@style/Widget.FindCheapGas.DetailSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_prices" />

                <LinearLayout
                    android:id="@+id/detail_price_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/detail_prices_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/detail_prices_empty"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone" />

                <!-- 부가시설: 있는 것만 칩으로 표시 -->
                <TextView
                    style="@style/Widget.FindCheapGas.DetailSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_facilities" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/detail_facilities"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/detail_facilities_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/detail_facilities_empty"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/detail_self_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/detail_self_estimated_note"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone" />
            </LinearLayout>

            <!--
                4단계: 평균가 대비 차이, 7일 가격 추이 (지금은 숨김)
                전국·지역 평균가와 비교, 최근 7일 전국 평균가 그래프
            -->
            <LinearLayout
                android:id="@+id/detail_average_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Widget.FindCheapGas.DetailSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_average_title" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/detail_trend_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Widget.FindCheapGas.DetailSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_trend_title" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!--
        3단계: 즐겨찾기, 길찾기 버튼 (지금은 숨김)
        길찾기는 카카오맵 / 티맵 중 선택해서 외부 앱을 연다.
    -->
    <LinearLayout
        android:id="@+id/detail_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/detail_favorite_button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/detail_favorite" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/detail_route_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/detail_route" />
    </LinearLayout>

</LinearLayout>

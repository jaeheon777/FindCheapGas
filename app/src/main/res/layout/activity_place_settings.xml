<?xml version="1.0" encoding="utf-8"?>
<!--
    집·회사 위치 화면 (설정 탭의 "집·회사 위치", 즐겨찾기 탭 비교 카드의 등록 버튼에서 열림).
    위쪽 툴바, 개인정보 안내, 집 / 회사 줄. 줄마다 등록(바꾸기)과 지우기 버튼이 있다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/place_settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/place_settings_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/place_settings_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/place_settings_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/place_settings_description"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_saving_notice"
                android:padding="10dp"
                android:text="@string/place_settings_privacy"
                android:textAppearance="?attr/textAppearanceBodySmall" />

            <include
                android:id="@+id/place_settings_home"
                layout="@layout/item_saved_place"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <include
                android:id="@+id/place_settings_work"
                layout="@layout/item_saved_place"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
    내 브랜드 화면 (설정 탭의 "내 브랜드"를 누르면 열림).
    위쪽 툴바, 회색 바탕에 흰 카드 하나로 묶은 브랜드 목록, 카드 아래 작은 안내 글자. 줄을 누르면 수정 시트가 열린다.
    브랜드는 열 곳 남짓이라 스크롤 안에서 한 번에 그린다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/brand_settings_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/brand_settings_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/brand_settings_title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_xxl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_l"
            android:paddingTop="@dimen/space_s"
            android:paddingEnd="@dimen/space_l">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/brand_settings_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_brand_setting" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Widget.FindCheapGas.SettingsFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/brand_settings_description" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>

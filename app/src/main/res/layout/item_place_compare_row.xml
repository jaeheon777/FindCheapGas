<?xml version="1.0" encoding="utf-8"?>
<!--
    집·회사 기준 비교 카드 안의 한 줄 (지금 조회 위치 / 집 근처 / 회사 근처). 목록 한 줄 규칙(Widget.FindCheapGas.ListRow.*)과 같다.
    - 왼쪽: 위치 이름(작게), 이득 1위 상호, 보조 글자 한 줄(브랜드 · 거리 · 가격 · 가져온 시각). 상호와 보조 글자는 말줄임
    - 오른쪽: 예상 총비용과 그 아래 "가장 저렴" 배지(라임 바탕) / "약 1,200원 더 들어요"(빨강) / "비슷해요"(회색).
      줄바꿈 없이 오른쪽 정렬하고 오른쪽이 먼저 폭을 차지한다.
    - 이득 1위가 없으면 상호 자리에 짧은 이유 (가져오는 중, 주유소 없음, 한도 도달, 오류, 가짜 데이터 범위 밖)
    - 등록하지 않았으면 줄 전체를 "집 위치 등록하기" 버튼 하나로 바꾼다.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:ignore="MergeRootFrame">

    <LinearLayout
        android:id="@+id/compare_row"
        style="@style/Widget.FindCheapGas.ListRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout style="@style/Widget.FindCheapGas.ListRow.Start">

            <TextView
                android:id="@+id/compare_row_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="집 근처 · 선릉역" />

            <TextView
                android:id="@+id/compare_row_station"
                style="@style/Widget.FindCheapGas.ListRow.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                tools:text="테헤란로주유소" />

            <TextView
                android:id="@+id/compare_row_detail"
                style="@style/Widget.FindCheapGas.ListRow.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="GS칼텍스 · 0.8km · 1,639원 · 약 1시간 전 가격" />

            <!-- 이득 1위가 없을 때 짧은 이유 -->
            <TextView
                android:id="@+id/compare_row_message"
                style="@style/Widget.FindCheapGas.ListRow.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:visibility="gone"
                tools:text="반경 3km 안에 주유소가 없어요" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/compare_row_end"
            style="@style/Widget.FindCheapGas.ListRow.End">

            <TextView
                android:id="@+id/compare_row_total"
                style="@style/Widget.FindCheapGas.ListRow.Amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="약 66,174원" />

            <!-- 가장 저렴: 라임 바탕 + 거의 검정 -->
            <TextView
                android:id="@+id/compare_row_cheapest"
                style="@style/Widget.FindCheapGas.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:background="@drawable/bg_badge_best"
                android:maxLines="1"
                android:text="@string/compare_cheapest"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- 약 1,200원 더 들어요 (빨강) / 비슷해요 (회색) -->
            <TextView
                android:id="@+id/compare_row_extra"
                style="@style/Widget.FindCheapGas.ListRow.AmountNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/saving_loss_text"
                android:visibility="gone"
                tools:text="약 1,200원 더 들어요" />
        </LinearLayout>
    </LinearLayout>

    <!-- 등록하지 않은 위치: 줄 안에 등록 버튼 하나 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/compare_row_register"
        style="@style/Widget.FindCheapGas.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_xs"
        android:layout_marginTop="@dimen/space_xs"
        android:layout_marginEnd="@dimen/space_xs"
        android:layout_marginBottom="@dimen/space_xs"
        android:gravity="start|center_vertical"
        android:visibility="gone"
        tools:text="집 위치 등록하기" />
</FrameLayout>

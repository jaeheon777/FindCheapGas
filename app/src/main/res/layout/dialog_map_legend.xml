<?xml version="1.0" encoding="utf-8"?>
<!--
    마커 색 안내 (목록 머리줄의 (?) 버튼). 색만으로 구분하지 않도록 색 점 옆에 글자를 함께 쓴다.
    초록 이득 / 회색 비슷(±1,000원) / 빨강 손해, 아래에 추정치라는 안내.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_xxl"
    android:paddingTop="@dimen/space_s"
    android:paddingEnd="@dimen/space_xxl"
    android:paddingBottom="@dimen/space_s">

    <TextView
        style="@style/Widget.FindCheapGas.MapLegendItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/map_legend_gain"
        app:drawableTint="@color/marker_gain_background" />

    <TextView
        style="@style/Widget.FindCheapGas.MapLegendItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/map_legend_similar"
        app:drawableTint="@color/marker_similar_background" />

    <TextView
        style="@style/Widget.FindCheapGas.MapLegendItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/map_legend_loss"
        app:drawableTint="@color/marker_loss_background" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:text="@string/map_legend_note"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
    홈 화면 위젯 정보. 기본 크기는 가로 4칸 · 세로 2칸이고, 가로 2칸 · 세로 1칸까지 줄일 수 있다.
    갱신은 WorkManager(3시간마다)가 하므로 updatePeriodMillis는 0이다.
    위젯을 놓을 때 WidgetConfigActivity에서 집 / 회사를 고르고, Android 12 이상에서는 길게 눌러 다시 고를 수 있다.
    previewLayout, targetCell*, widgetFeatures는 Android 12 이상에서만 쓰이고, 그 아래에서는 minWidth/minHeight를 쓴다.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:configure="com.example.findcheapgas.widget.WidgetConfigActivity"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_station"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:previewLayout="@layout/widget_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable"
    tools:targetApi="31" />
